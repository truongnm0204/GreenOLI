# Reverse proxy + HTTPS (Let's Encrypt) for GreenOLI on VPS
# Domain: greenoli.id.vn (set via SITE_ADDRESS in .env)
# Compose mounts this file into the caddy service.

{
	email {$CADDY_EMAIL:admin@greenoli.id.vn}
}

http://{$SITE_ADDRESS:greenoli.id.vn}, https://{$SITE_ADDRESS:greenoli.id.vn} {
	encode gzip zstd

	# Next.js + Payload (container name / service: web)
	reverse_proxy web:3000

	header {
		# Basic hardening (safe defaults)
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
	}
}

http://www.{$SITE_ADDRESS:greenoli.id.vn}, https://www.{$SITE_ADDRESS:greenoli.id.vn} {
	redir https://{$SITE_ADDRESS:greenoli.id.vn}{uri} permanent
}

