# ============================================================
# GreenOLI — VPS production env (copy to .env on the server)
# Domain: greenoli.id.vn
# VPS IP example: 162.4.177.116
# ============================================================

# --- Public URL (HTTPS) — must match DNS A record ---
SITE_ADDRESS=greenoli.id.vn
NEXT_PUBLIC_SERVER_URL=https://greenoli.id.vn
# Email for Let's Encrypt expiry notices
CADDY_EMAIL=admin@greenoli.id.vn

# --- Postgres (Docker internal) ---
POSTGRES_USER=greenoli
# Use a long random password WITHOUT special URI chars: @ : / # ? & %
# Example generator: openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=greenoli

# --- Payload ---
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=CHANGE_ME_LONG_RANDOM_HEX_64_CHARS

# --- Optional SMTP (contact / lead notify) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_NOTIFY_EMAIL=

# --- Optional analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
