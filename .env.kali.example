# ============================================================
# GreenOLI — Kali production env (copy to .env on the server)
# Domain: greenoli.vn   via Cloudflare Tunnel (no open ports)
# ============================================================

# --- Public URL (HTTPS, terminated at Cloudflare edge) ---
NEXT_PUBLIC_SERVER_URL=https://greenoli.vn

# --- Cloudflare Tunnel token ---
# Zero Trust → Networks → Tunnels → <tunnel> → Configure → token
# (long string starting with "eyJ...")
TUNNEL_TOKEN=CHANGE_ME_TUNNEL_TOKEN

# --- Postgres (Docker internal only) ---
POSTGRES_USER=greenoli
# Long random password WITHOUT URI-special chars: @ : / # ? & %
# openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
POSTGRES_DB=greenoli

# --- Payload ---
# openssl rand -hex 32
PAYLOAD_SECRET=CHANGE_ME_LONG_RANDOM_HEX_64_CHARS

# --- Optional SMTP (contact / lead notify) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
LEAD_NOTIFY_EMAIL=

# --- Optional analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
